ENV=production

# Required for the web app
DATABASE_URL=postgresql://user:password@host:6543/postgres
GROQ_API_KEY=your_groq_api_key
# Optional existing database account to reuse; defaults to internal account 1
WEB_SINGLE_USER_ID=your_existing_database_user_id
WEB_ACCESS_KEY=make_a_long_private_random_value

# Optional/unused by the current web UI unless you add features that call them
TAVILY_API_KEY=
HF_API_KEY=
FREEPIK_API_KEY=
