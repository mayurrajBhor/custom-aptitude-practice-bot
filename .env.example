ENV=production

# Required for the web app
DATABASE_URL=postgresql://user:password@host:6543/postgres
GROQ_API_KEY=your_groq_api_key
WEB_SINGLE_USER_ID=your_numeric_telegram_user_id
WEB_ACCESS_KEY=make_a_long_private_random_value

# Required only if you also run the Telegram bot worker
TELEGRAM_BOT_TOKEN=your_production_telegram_bot_token
TELEGRAM_BOT_TOKEN_TEST=your_test_telegram_bot_token
WEB_APP_URL=https://your-render-service.onrender.com/?key=make_a_long_private_random_value

# Optional/unused by the current web UI unless you add features that call them
TAVILY_API_KEY=
HF_API_KEY=
FREEPIK_API_KEY=
